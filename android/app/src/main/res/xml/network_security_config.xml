<?xml version="1.0" encoding="utf-8"?>
<!--
  Allows plain-text (HTTP) connections ONLY to local/private endpoints so the
  app can reach a local model server (e.g. Ollama, LM Studio, llama.cpp running
  in Termux or on another device on the LAN). All public internet traffic
  still requires HTTPS.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <!-- Localhost / loopback (same-device model servers, e.g. Termux) -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">::1</domain>
    </domain-config>
    <!-- Private LAN ranges (a model server on another device) -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.1.1.1</domain>
        <domain includeSubdomains="false">192.168.0.0</domain>
        <domain includeSubdomains="false">192.168.1.0</domain>
    </domain-config>
</network-security-config>
